# Copy to .env and edit. Every variable is optional until a script needs it.
# Nothing here is required to simply use the atlas files under atlas/.

# Root of third-party data you have fetched yourself. Never shipped with this repo.
CYTO7_DATA_DIR=

# Connectome Workbench bin directory (contains wb_command).
# Needed for fsaverage to fs_LR 32k resampling.
CYTO7_WORKBENCH_DIR=

# FreeSurfer installation, for mri_surf2surf.
CYTO7_FREESURFER_HOME=

# FieldTrip, for the MEG source reconstruction only.
CYTO7_FIELDTRIP_DIR=

# MATLAB executable, for the MEG source reconstruction only. Optional; falls back to
# the default Windows install path of the version the analysis was run with.
CYTO7_MATLAB_BIN=

# Working space for large intermediates. Optional; defaults to a temp directory.
CYTO7_SCRATCH_DIR=
